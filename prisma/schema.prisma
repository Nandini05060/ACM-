generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Models

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  projects      Project[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  TEAM_MEMBER
  CHAIRPERSON
  FACULTY
  SUPERADMIN
  EVENT_COORDINATOR
  ATTENDANCE_MANAGER
}

// Application Models

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  ONGOING
  EVALUATION
  ENDED
}

model Event {
  id                  String    @id @default(cuid())
  title               String
  shortDescription    String?   @db.Text
  description         String    @db.Text
  objectives          String?   @db.Text
  schedule            String?   @db.Text
  speakerDetails      String?   @db.Text
  rules               String?   @db.Text
  contactInfo         String?   @db.Text
  date                DateTime
  endDate             DateTime?
  time                String?
  location            String?
  venueInfo           String?   @db.Text
  category            String
  imageUrl            String?
  capacity            Int       @default(0)
  registrationDeadline DateTime?
  isPublished         Boolean   @default(false)
  status              EventStatus @default(UPCOMING)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  announcements Announcement[]
  registration  EventRegistration?
  attendance    EventAttendance?
  attendees     Attendee[]
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  message   String   @db.Text
  createdBy String   // Name of the coordinator
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventRegistration {
  id              String @id @default(cuid())
  eventId         String @unique
  registeredCount Int    @default(0)
  approvedCount   Int    @default(0)
  remainingSeats  Int    @default(0)

  event           Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventAttendance {
  id           String @id @default(cuid())
  eventId      String @unique
  presentCount Int    @default(0)
  absentCount  Int    @default(0)

  event        Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  githubUrl   String?
  demoUrl     String?
  techStack   String[]
  imageUrl    String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  PENDING
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Attendee {
  id                String   @id @default(cuid())
  ticketId          String   @unique
  eventId           String
  
  // Personal Info
  fullName          String
  email             String
  mobileNumber      String?
  collegeName       String?
  department        String?
  yearSemester      String?
  
  // Additional Info
  gender            String?
  city              String?
  skillsInterests   String?   @db.Text
  emergencyContact  String?

  registrationStatus RegistrationStatus @default(PENDING)
  attendanceStatus   AttendanceStatus   @default(PENDING)

  createdAt         DateTime @default(now())

  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  INTERVIEW_SCHEDULED
}

model VolunteerApplication {
  id                String   @id @default(cuid())
  fullName          String
  studentId         String
  email             String
  mobileNumber      String
  yearOfStudy       String
  branch            String
  isAcmMember       Boolean
  hasVolunteered    Boolean
  pastEvents        String?  @db.Text
  domains           String[]
  skills            String[]
  relevantExp       String?  @db.Text
  isAvailable       Boolean
  hoursPerWeek      String
  whyVolunteer      String   @db.Text
  fitReason         String   @db.Text
  teamExperience    String   @db.Text
  status            VolunteerStatus @default(PENDING)
  interviewDate     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
